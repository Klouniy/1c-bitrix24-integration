// Общий модуль Мой_Bitrix24_Товары
// Флаги: Сервер = Истина, Вызов сервера = Ложь, Клиент = Ложь

Функция URL()
    Возврат Константы.URL_Bitrix24.Получить();
КонецФункции

Функция НайтиИлиСоздатьРаздел(Наименование, ИДРодителя = 0)
    КаталогИД = Константы.ИД_КаталогаБитрикс24.Получить();
    
    // Сначала ищем в кэше (регистре или параметре сеанса)
    // Если нет - создаем:
    Поля = Новый Структура;
    Поля.Вставить("iblockId", КаталогИД);
    Поля.Вставить("name",     Наименование);
    Поля.Вставить("active",   "Y");
    
    Если ЗначениеЗаполнено(ИДРодителя) И Число(ИДРодителя) > 0 Тогда
        Поля.Вставить("iblockSectionId", Число(ИДРодителя));
    КонецЕсли;
    
    // Оборачиваем в fields - требование API
    Параметры = Новый Структура("fields", Поля);
    Ответ = OPI_ЗапросыHTTP.PostСТелом(URL() + "catalog.section.add", Параметры);
    
    Если Ответ <> Неопределено И Ответ.Получить("result") <> Неопределено Тогда
        Возврат Число(Ответ.Получить("result").Получить("section").Получить("id"));
    КонецЕсли;
    Возврат 0;
КонецФункции