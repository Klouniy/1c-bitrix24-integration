// Общий модуль Мой_Bitrix24
// Флаги: Сервер = Истина, Вызов сервера = Ложь, Клиент = Ложь

Функция URL()
    Возврат Константы.URL_Bitrix24.Получить();
КонецФункции

// --- СЛУЖЕБНЫЕ ФУНКЦИИ ---

Функция ОтветВСтроку(Ответ)
    Если Ответ = Неопределено Тогда
        Возврат "Неопределено";
    КонецЕсли;
    Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
        Части = Новый Массив;
        Для Каждого Пара Из Ответ Цикл
            Части.Добавить(Строка(Пара.Ключ) + "=" + ОтветВСтроку(Пара.Значение));
        КонецЦикла;
        Возврат "{" + СтрСоединить(Части, ", ") + "}";
    КонецЕсли;
    Если ТипЗнч(Ответ) = Тип("Массив") Тогда
        Части = Новый Массив;
        Для Каждого Элемент Из Ответ Цикл
            Части.Добавить(ОтветВСтроку(Элемент));
        КонецЦикла;
        Возврат "[" + СтрСоединить(Части, ", ") + "]";
    КонецЕсли;
    Возврат Строка(Ответ);
КонецФункции

Функция ЭтоУспешныйОтвет(Результат)
    Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Соответствие") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Результат.Получить("error") <> Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат Результат.Получить("result") <> Неопределено;
КонецФункции

Функция ПолучитьИДВоронкиПоДокументу(ДокументОбъект)
    Попытка
        Подразделение = ДокументОбъект.Подразделение;
    Исключение
        Возврат 0;
    КонецПопытки;
    
    Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
        Возврат 0;
    КонецЕсли;
    
    Наименование = СокрЛП(Подразделение.Наименование);
    Если Наименование = "АК" ИЛИ Наименование = "ТУК" Тогда
        Возврат Константы.ИД_Воронки_АК_ТУК.Получить();
    ИначеЕсли Наименование = "Стакан" Тогда
        Возврат Константы.ИД_Воронки_Стакан.Получить();
    КонецЕсли;
    Возврат 0;
КонецФункции

Функция ПолучитьСтадиюДляДокумента(ТипДокумента, ИДВоронки)
    Если ИДВоронки = 3 Тогда // АК/ТУК
        Если ТипДокумента = "ЗаказПокупателя" Тогда Возврат "C3:UC_HAQ9K4";
        ИначеЕсли ТипДокумента = "ЗаказНаПроизводство" Тогда Возврат "C3:UC_99TFD9";
        ИначеЕсли ТипДокумента = "РеализацияТоваровУслуг" Тогда Возврат "C3:FINAL_INVOICE";
        ИначеЕсли ТипДокумента = "ЗакрытиеЗаказовПокупателей" Тогда Возврат "C3:WON";
        КонецЕсли;
    ИначеЕсли ИДВоронки = 2 Тогда // Стакан
        Если ТипДокумента = "ЗаказПокупателя" Тогда Возврат "C2:FINAL_INVOICE";
        ИначеЕсли ТипДокумента = "ЗаказНаПроизводство" Тогда Возврат "C2:UC_C2LON4";
        ИначеЕсли ТипДокумента = "РеализацияТоваровУслуг" Тогда Возврат "C2:UC_5WOELD";
        ИначеЕсли ТипДокумента = "ЗакрытиеЗаказовПокупателей" Тогда Возврат "C2:WON";
        КонецЕсли;
    КонецЕсли;
    Возврат "";
КонецФункции

// --- РАБОТА СО СДЕЛКАМИ ---

Функция СобратьПоляСделки(ДокументОбъект)
    Поля = Новый Структура;
    Поля.Вставить("TITLE", СтрШаблон("%1 №%2 от %3", ДокументОбъект.Метаданные().Представление(), ДокументОбъект.Номер, Формат(ДокументОбъект.Дата, "ДФ=dd.MM.yyyy")));
    Поля.Вставить("OPPORTUNITY", ДокументОбъект.СуммаДокумента);
    Поля.Вставить("CURRENCY_ID", "RUB");
    Поля.Вставить("BEGINDATE", Формат(ДокументОбъект.Дата, "ДФ=yyyy-MM-dd"));
    
    Если ЗначениеЗаполнено(ДокументОбъект.Ответственный) Тогда
        ИД = Мой_Bitrix24_Справочники.НайтиПользователя(ДокументОбъект.Ответственный);
        Если ИД > 0 Тогда Поля.Вставить("ASSIGNED_BY_ID", ИД); КонецЕсли;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
        ИД = Мой_Bitrix24_Справочники.НайтиИлиСоздатьКомпанию(ДокументОбъект.Контрагент);
        Если ИД > 0 Тогда Поля.Вставить("COMPANY_ID", ИД); КонецЕсли;
    КонецЕсли;
    
    ИДВоронки = ПолучитьИДВоронкиПоДокументу(ДокументОбъект);
    Если ИДВоронки > 0 Тогда
        Поля.Вставить("CATEGORY_ID", ИДВоронки);
        ИДСтадии = ПолучитьСтадиюДляДокумента("ЗаказПокупателя", ИДВоронки);
        Если ЗначениеЗаполнено(ИДСтадии) Тогда Поля.Вставить("STAGE_ID", ИДСтадии); КонецЕсли;
    КонецЕсли;
    
    Возврат Поля;
КонецФункции

Процедура СинхронизироватьСделкуСДокументом(ДокументОбъект) Экспорт
    ИДСделки = Мой_Bitrix24_Справочники.ПрочитатьИДБитрикс24(ДокументОбъект.Ссылка);
    Поля = СобратьПоляСделки(ДокументОбъект);
    
    Если ЗначениеЗаполнено(ИДСделки) Тогда
        Результат = OPI_Bitrix24.ИзменитьСделку(URL(), ИДСделки, Поля);
    Иначе
        Результат = OPI_Bitrix24.СоздатьСделку(URL(), Поля);
        Если ЭтоУспешныйОтвет(Результат) Тогда
            ИДСделки = Строка(Результат.Получить("result"));
            Мой_Bitrix24_Справочники.ЗаписатьИДБитрикс24(ДокументОбъект.Ссылка, ИДСделки);
            ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
        КонецЕсли;
    КонецЕсли;
    
    Если ЭтоУспешныйОтвет(Результат) И ЗначениеЗаполнено(ИДСделки) Тогда
        // Добавляем товары
        МетаданныеДок = ДокументОбъект.Метаданные();
        Если МетаданныеДок.ТабличныеЧасти.Найти("Товары") <> Неопределено Тогда
            Позиции = Мой_Bitrix24_Товары.СобратьТоварныеПозиции(ДокументОбъект.Товары);
            Если Позиции.Количество() > 0 Тогда
                Мой_Bitrix24_Товары.УстановитьТоварныеПозицииСделки(ИДСделки, Позиции);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

// --- ЗАКРЫТИЕ ЗАКАЗОВ (АВТОМАТИЗАЦИЯ) ---

Функция ЗакрытьЗаказыПокупателей(МассивЗаказов, ПричинаЗакрытия = Неопределено) Экспорт
    Если МассивЗаказов.Количество() = 0 Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    ДокументЗакрытия = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
    ДокументЗакрытия.Дата = ТекущаяДата();
    
    Для Каждого ЗаказСсылка Из МассивЗаказов Цикл
        НоваяСтрока = ДокументЗакрытия.Заказы.Добавить();
        НоваяСтрока.ЗаказПокупателя = ЗаказСсылка;
    КонецЦикла;
    
    Попытка
        ДокументЗакрытия.Записать(РежимЗаписиДокумента.Проведение);
        Возврат ДокументЗакрытия.Ссылка;
    Исключение
        ЗаписьЖурналаРегистрации("Bitrix24", УровеньЖурналаРегистрации.Ошибка, , ,
            "Ошибка в ЗакрытьЗаказыПокупателей: " + ОписаниеОшибки());
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// --- СКЛАД (Интеграция с Bitrix24) ---

Функция СоздатьСкладскойДокументВБитрикс24(ДокументОбъект, ИДСкладаБитрикс24) Экспорт
    URL_API = URL();
    
    // 1. Создаем шапку
    ПоляДокумента = Новый Структура;
    ПоляДокумента.Вставить("docType", "S"); // 'S' - Оприходование, 'A' - Приход, 'D' - Списание
    ПоляДокумента.Вставить("currency", "RUB");
    ПоляДокумента.Вставить("responsibleId", 4); 
    ПоляДокумента.Вставить("dateDocument", Формат(ДокументОбъект.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "+03:00");
    ПоляДокумента.Вставить("title", "Оприходование по реализации №" + ДокументОбъект.Номер);
    
    Параметры = Новый Структура("fields", ПоляДокумента);
    Ответ = OPI_ЗапросыHTTP.PostСТелом(URL_API + "catalog.document.add", Параметры);
    
    Если Ответ = Неопределено ИЛИ Ответ.Получить("error") <> Неопределено Тогда
        ЗаписьЖурналаРегистрации("Bitrix24", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка создания документа: " + ОтветВСтроку(Ответ));
        Возврат 0;
    КонецЕсли;
    
    ОбъектДок = Ответ.Получить("result").Получить("document");
    ИДДокумента = ОбъектДок.Получить("id");
    
    // 2. Добавляем товары
    Для Каждого СтрокаТЧ Из ДокументОбъект.Товары Цикл
        ИДТовара = Мой_Bitrix24_Товары.НайтиИлиСоздатьТовар(СтрокаТЧ.Номенклатура);
        Если ИДТовара = 0 Тогда Продолжить; КонецЕсли;
        
        ПоляТовара = Новый Структура;
        ПоляТовара.Вставить("docId", ИДДокумента);
        ПоляТовара.Вставить("elementId", ИДТовара);
        ПоляТовара.Вставить("storeTo", ИДСкладаБитрикс24);
        ПоляТовара.Вставить("amount", СтрокаТЧ.Количество);
        ПоляТовара.Вставить("purchasingPrice", СтрокаТЧ.Цена);
        
        OPI_ЗапросыHTTP.PostСТелом(URL_API + "catalog.document.element.add", Новый Структура("fields", ПоляТовара));
    КонецЦикла;
    
    // 3. Проводим
    ОтветПровед = OPI_ЗапросыHTTP.PostСТелом(URL_API + "catalog.document.conduct", Новый Структура("id", ИДДокумента));
    
    Если ОтветПровед = Неопределено ИЛИ ОтветПровед.Получить("error") <> Неопределено Тогда
        ЗаписьЖурналаРегистрации("Bitrix24", УровеньЖурналаРегистрации.Ошибка, , , "Ошибка проведения: " + ОтветВСтроку(ОтветПровед));
    КонецЕсли;
    
    Возврат ИДДокумента;
КонецФункции