// Общий модуль Мой_Bitrix24_Справочники
// Флаги: Сервер = Истина, Вызов сервера = Ложь, Клиент = Ложь

Функция URL()
    Возврат Константы.URL_Bitrix24.Получить();
КонецФункции

// Безопасный поиск компании по точному названию
Функция НайтиКомпаниюПоФильтру(ПолеФильтра, Значение)
    Фильтр = Новый Структура(ПолеФильтра, Значение);
    Селект = Новый Массив;
    Селект.Добавить("ID");
    Селект.Добавить("TITLE");
    
    Параметры = Новый Структура;
    Параметры.Вставить("filter", Фильтр); // Обязательно маленькими буквами!
    Параметры.Вставить("select", Селект);
    
    Ответ = OPI_ЗапросыHTTP.PostСТелом(URL() + "crm.company.list", Параметры);
    
    Если Ответ = Неопределено ИЛИ ТипЗнч(Ответ) <> Тип("Соответствие") Тогда
        Возврат 0;
    КонецЕсли;
    
    Результат = Ответ.Получить("result");
    Если Результат = Неопределено ИЛИ ТипЗнч(Результат) <> Тип("Массив") ИЛИ Результат.Количество() = 0 Тогда
        Возврат 0;
    КонецЕсли;
    
    // Перебираем все и ищем точное совпадение, чтобы не привязаться к чужой компании
    Для Каждого Компания Из Результат Цикл
        Если ПолеФильтра = "TITLE" Тогда
            Если СокрЛП(Компания.Получить("TITLE")) <> СокрЛП(Значение) Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        Возврат Число(Компания.Получить("ID"));
    КонецЦикла;
    
    Возврат 0;
КонецФункции

// Главная функция получения/создания контрагента
Функция НайтиИлиСоздатьКомпанию(Контрагент) Экспорт
    Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
        Возврат 0;
    КонецЕсли;
    
    // 1. Ищем в регистре сведений (кэш)
    ИД = ПрочитатьИДБитрикс24(Контрагент);
    Если ИД > 0 Тогда
        Возврат ИД;
    КонецЕсли;
    
    // 2. Ищем по названию в Б24
    ИД = НайтиКомпаниюПоФильтру("TITLE", СокрЛП(Контрагент.Наименование));
    
    Если ИД > 0 Тогда
        ЗаписатьИДБитрикс24(Контрагент, ИД);
        Возврат ИД;
    КонецЕсли;
    
    // 3. Создаем новую
    Поля = Новый Структура;
    Поля.Вставить("TITLE", СокрЛП(Контрагент.Наименование));
    Поля.Вставить("XML_ID", Строка(Контрагент.УникальныйИдентификатор()));
    
    Параметры = Новый Структура("fields", Поля);
    Ответ = OPI_ЗапросыHTTP.PostСТелом(URL() + "crm.company.add", Параметры);
    
    Если Ответ <> Неопределено И Ответ.Получить("result") <> Неопределено Тогда
        НовыйИД = Число(Ответ.Получить("result"));
        ЗаписатьИДБитрикс24(Контрагент, НовыйИД);
        Возврат НовыйИД;
    КонецЕсли;
    
    Возврат 0;
КонецФункции